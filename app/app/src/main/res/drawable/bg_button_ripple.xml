<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1B5E20"> <!-- couleur du ripple (vert foncé) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lime"/> <!-- fond vert clair -->
            <corners android:radius="12dp"/>  <!-- coins arrondis -->
            <stroke android:width="1dp" android:color="#1B5E20"/> <!-- bord vert foncé -->
        </shape>
    </item>
</ripple>
